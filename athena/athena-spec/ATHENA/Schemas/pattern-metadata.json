{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athena.local/schemas/pattern-metadata.json",
  "title": "PatternMetadata",
  "description": "APS-PAT-REGISTRY-001 pattern catalog entry metadata",
  "type": "object",
  "required": ["pattern_id", "aps_id", "category", "status"],
  "properties": {
    "pattern_id": { "type": "string", "minLength": 1 },
    "aps_id": { "type": "string", "pattern": "^APS-PAT-" },
    "category": {
      "type": "string",
      "enum": [
        "Pattern-Architecture",
        "Swing-Engine",
        "Market-Structure",
        "Support-Resistance",
        "Trendline-Engine",
        "Candlestick-Engine",
        "Chart-Patterns",
        "Breakout-Engine",
        "Volume-Confirmation",
        "Smart-Money-Concepts",
        "Wyckoff-Engine",
        "Elliott-Wave-Engine",
        "Pattern-Scoring",
        "Pattern-Registry",
        "Pattern-Validation",
        "Golden-Datasets"
      ]
    },
    "status": { "type": "string", "enum": ["MVP", "Partial", "Deferred"] }
  },
  "additionalProperties": false
}
