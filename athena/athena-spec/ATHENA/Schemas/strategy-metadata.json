{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athena.local/schemas/strategy-metadata.json",
  "title": "StrategyMetadata",
  "description": "APS-STRAT-REGISTRY-001 strategy catalog entry metadata",
  "type": "object",
  "required": ["strategy_id", "aps_id", "name", "status"],
  "properties": {
    "strategy_id": { "type": "string", "minLength": 1 },
    "aps_id": { "type": "string", "pattern": "^APS-" },
    "name": { "type": "string" },
    "status": { "type": "string", "enum": ["MVP", "Deferred"] }
  },
  "additionalProperties": false
}
